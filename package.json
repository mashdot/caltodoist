{
  "name": "caltodoist",
  "version": "1.0.0",
  "description": "Cal.com to Todoist webhook integration",
  "main": "dist/netlify/functions/api.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r public/* dist/",
    "dev": "netlify dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "keywords": ["cal.com", "todoist", "webhook", "netlify"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@doist/todoist-api-typescript": "^5.0.0",
    "@netlify/blobs": "^8.1.0",
    "@netlify/functions": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.14.0"
  }
}
